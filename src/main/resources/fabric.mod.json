{
  "schemaVersion": 1,
  "id": "vigicam",
  "version": "${version}",
  "name": "Aegis - Scute60",
  "description": "Câmera de segurança: ao ver pela câmera, o shader (visão noturna + VHS + fisheye) ativa durante o uso. Feito pela equipe Scute60.",
  "authors": [
    { "name": "Scute60", "contact": { "homepage": "https://x.com/Scute6o" } }
  ],
  "contact": {
    "homepage": "https://x.com/Scute6o"
  },
  "icon": "assets/vigicam/icon.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.vigicam.VigiCam"],
    "client": ["com.example.vigicam.VigiCamClient"]
  },
  "mixins": [
    { "config": "vigicam.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
